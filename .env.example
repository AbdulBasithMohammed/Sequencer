# Public — safe to expose in client bundles.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Server-only — never expose in client bundles. Required for actions that
# need to bypass RLS (none yet, but reserved for cron/admin tasks).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Supabase CLI — Personal Access Token used by the CLI for db push / migration
# list. Only needed locally; not used at runtime.
SUPABASE_ACCESS_TOKEN=sbp_YOUR_PERSONAL_ACCESS_TOKEN
